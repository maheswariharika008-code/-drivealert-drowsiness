# Backend URL is set in app.json under expo.extra.backendUrl (Expo doesn't
# use .env files the same way as web — this file documents what to change).
#
# For local development pointing at a phone on the same WiFi network as your
# backend, use your machine's LAN IP, not localhost:
#   "extra": { "backendUrl": "http://192.168.1.42:5000" }
#
# For production, point at your deployed Render backend URL.
